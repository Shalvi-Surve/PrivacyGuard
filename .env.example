APP_ENV=development
DATABASE_URL=sqlite:///./adaptive_dp.db
# Development-only placeholder. Generate a unique value locally; production rejects this template.
JWT_SECRET_KEY=development-only-change-this-secret-before-use
JWT_ACCESS_TOKEN_MINUTES=30
# Optional API origin. Leave blank for same-origin requests; Vite proxies /api and /health to 127.0.0.1:8000.
# For a separately hosted frontend in production, set this to the API origin, for example https://api.example.com.
VITE_API_BASE_URL=
# Optional Vite development proxy override (backend origin only; no path suffix).
VITE_API_PROXY_TARGET=
# Comma-separated exact browser origins for production CORS; development localhost origins are preconfigured.
CORS_ALLOWED_ORIGINS=
